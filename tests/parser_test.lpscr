@mode(host.scripted)

# Unit tests for yq's filter lexer and parser (lib/lexer.lpscr,
# lib/parser.lpscr): tokens, string escapes, precedence, and syntax errors.
#
# Runtime: host.scripted, run by the test runner: `make test` interprets
# this file with Stage0 (`loup-bootstrap test --no-parallel --file`), one
# test per `func test_*()`. It imports lib/ with relative imports. It is not
# part of the program.

from debug.assert import (expect, expectEq);
from system.json import (stringify);
from ..lib.lexer import (TokKind, Token, FilterSyntaxError, tokenize);
from ..lib.parser import (compile);
from ..lib.eval import (Env, run);

func kinds(filter: string): string {
    var out: list[string] = [];
    for (tok in tokenize(filter)) {
        let name = match tok.kind {
            TokKind.Ident => "ident",
            TokKind.Field => "field",
            TokKind.Var => "var",
            TokKind.Format => "format",
            TokKind.Number => "number",
            TokKind.Str => "str",
            TokKind.Symbol => "symbol",
            TokKind.End => "end",
        };
        out.push(name + ":" + tok.text);
    }
    return out.join(" ");
}

# The output of a filter run on null, as JSON.
func value(filter: string): string {
    var parts: list[string] = [];
    var vars: dict[string, Any] = {};
    for (out in run(compile(filter, []), None, Env(vars, None))) {
        parts.push(stringify(out));
    }
    return parts.join(" ");
}

func syntax(filter: string): string {
    try {
        compile(filter, []);
    } catch (FilterSyntaxError as e) {
        return e.message;
    }
    return "";
}

func test_tokens(): void {
    expectEq(kinds(".a[0]|keys"), "field:a symbol:[ number:0 symbol:] symbol:| ident:keys end:", "path");
    expectEq(kinds(". .. $x @csv 1.5e3 // != # comment"), "symbol:. symbol:.. var:x format:csv number:1.5e3 symbol:// symbol:!= end:", "symbols");
    expectEq(kinds("\"a \\(.b | \"c\") d\""), "str:a \\(.b | \"c\") d end:", "string with an interpolation");
}

func test_strings(): void {
    expectEq(value("\"tab\\tquote\\\"slash\\/\\u00e9\""), "\"tab\\tquote\\\"slash/é\"", "escapes");
    expectEq(value("\"\\(1 + 1) is \\(\"two\")\""), "\"2 is two\"", "interpolation");
}

func test_precedence(): void {
    expectEq(value("1 + 2 * 3 - 4 / 2"), "5", "arithmetic");
    expectEq(value("1, 2 | . + 10"), "11 12", "comma binds tighter than pipe");
    expectEq(value("null // 1 + 1"), "2", "// is looser than +");
    expectEq(value("true or false and false"), "true", "and before or");
    expectEq(value("1 < 2 and 3 > 2"), "true", "comparison before and");
    expectEq(value("-1 + 3"), "2", "unary minus");
    expectEq(value("[1, 2] as $x | $x[1]"), "2", "as binding");
    expectEq(value("{a: 1 | . + 1, b: 2}"), "{\"a\":2,\"b\":2}", "pipes inside an object value");
}

func test_syntax_errors(): void {
    expectEq(syntax(".a |"), "syntax error: unexpected end of filter", "dangling pipe");
    expectEq(syntax(".a ]"), "syntax error: unexpected ']' at offset 3", "stray bracket");
    expectEq(syntax("nosuch(1)"), "nosuch/1 is not defined", "unknown function");
    expectEq(syntax("length(1)"), "length/1 is not defined", "wrong arity");
    expectEq(syntax("$undefined"), "$undefined is not defined", "unknown variable");
    expectEq(syntax(".a = 1"), "assignment (=) is not supported", "assignment");
    expectEq(syntax("reduce .[] as $x (0; . + $x)"), "'reduce' is not supported by this yq", "reduce");
    expectEq(syntax("\"open"), "unterminated string literal", "string");
    expectEq(syntax("@nope"), "@nope is not a valid format", "format");
    expect(syntax("if . then 1 else 2 end | [.[]?] | {a, \"b\": .c, (.d): 1, $__x}") != "", "$__x is not in scope");
}
