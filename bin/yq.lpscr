#!/usr/bin/env -S loup run
@mode(host.scripted)

# yq: query YAML files with jq filters and print the results as JSON or
# YAML.
#
# Runtime: host.scripted. The program's entry point: the Loup scripted
# runtime interprets this file from source (`loup run bin/yq.lpscr -- ARGS`,
# as `make run`, tests/e2e.sh and CI do; on Linux x86-64 that is the
# self-hosted driver). Its top-level statements run in order and there is
# no compile step: a script entry cannot be compiled, so the project has no
# binary. `make check` type-checks it, with every lib/ module it imports,
# using Stage0 (`loup-bootstrap check`). Long options must follow `--`
# under `loup run`; short ones (`-rc`) pass through.
#
# Structure: parse the command line (usage errors exit 2), compile the
# filter (syntax errors exit 3) before reading anything, then read the
# inputs as a stream of YAML documents (a generator over files and their
# documents) and run the filter on each, printing results as they come. A
# file that cannot be read, or a filter that fails on one input, is
# reported and the run goes on; the exit status says what happened.

from io.fs import (isDir);
from ..lib.appinfo import (APP_NAME, EXIT_OK, EXIT_FALSE, EXIT_USAGE, EXIT_COMPILE, EXIT_NO_OUTPUT, EXIT_ERROR);
from ..lib.usage import (usage, version_line);
from ..lib.args import (Options, parse_args);
from ..lib.lexer import (FilterSyntaxError);
from ..lib.parser import (compile);
from ..lib.ast import (Node);
from ..lib.eval import (Env, run);
from ..lib.values import (Failure, truthy);
from ..lib.yamlin import (InputError, read_values);
from ..lib.output import (Style, make_style, render);

# One input document and the file it came from (null for standard input).
class Input {
    pub let value: Any;
    pub let filename: Any;

    new(value: Any, filename: Any) {
        this.value = value;
        this.filename = filename;
    }
}

let parsed = parse_args(args());
if (parsed.is_err()) {
    printErr(APP_NAME + ": " + parsed.unwrap_err());
    printErr("Try '" + APP_NAME + " --help' for more information.");
    exit(EXIT_USAGE);
}
let opts: Options = parsed.unwrap();
if (opts.help) {
    println(usage());
    exit(EXIT_OK);
}
if (opts.version) {
    println(version_line());
    exit(EXIT_OK);
}

# The filter is compiled before any input is read: a syntax error costs
# nothing else.
func compile_or_exit(source: string, names: list[string]): Node {
    try {
        return compile(source, names);
    } catch (FilterSyntaxError as e) {
        printErr(APP_NAME + ": error: " + e.message);
        printErr(APP_NAME + ": 1 compile error");
        exit(EXIT_COMPILE);
    }
    return Node.Identity;
}

let filter: Node = compile_or_exit(opts.filter, opts.arg_names);

var status = EXIT_OK;

# The documents of every file in order; a file that cannot be read or
# parsed is reported (status 2) and skipped from there on.
gen func inputs(files: list[string]): Iterable[Input] {
    global status;
    for (file in files) {
        let path = if (file == "-") { "/dev/stdin" } else { file };
        let filename: Any = if (file == "-") { None } else { file };
        # Checked first: the self-hosted `loup run` cannot catch IoError.
        if (!exists(path)) {
            printErr(APP_NAME + ": " + file + ": No such file or directory");
            status = EXIT_USAGE;
        } else if (isDir(path)) {
            printErr(APP_NAME + ": " + file + ": Is a directory");
            status = EXIT_USAGE;
        } else {
            let shown = if (file == "-") { "<stdin>" } else { file };
            for (value in read_values(readText(path), shown)) {
                if (value is InputError) {
                    printErr(APP_NAME + ": " + (value as InputError).message);
                    status = EXIT_USAGE;
                } else {
                    yield Input(value, filename);
                }
            }
        }
    }
}

let files: list[string] = if (opts.files.len() == 0) { ["-"] } else { opts.files };
var work: list[Input] = [];
if (opts.null_input) {
    work.push(Input(None, None));
} else if (opts.slurp) {
    var all_values: list[Any] = [];
    for (input in inputs(files)) {
        all_values.push(input.value);
    }
    work.push(Input(all_values, None));
}

let style: Style = make_style(opts.yaml, opts.raw, if (opts.compact) { 0 } else { opts.indent }, opts.sort_keys);
var results = 0;
var last: Any = None;

# Runs the filter on one input, printing results as they come.
func process(input: Input): void {
    global results;
    global last;
    global status;
    let env = Env(opts.arg_values, input.filename);
    for (value in run(filter, input.value, env)) {
        # An error comes as the last item of the stream, after the results
        # before it.
        if (value is Failure) {
            printErr(APP_NAME + ": error: " + (value as Failure).message);
            status = EXIT_ERROR;
            break;
        }
        if (opts.yaml and results > 0) {
            println("---");
        }
        if (opts.join) {
            print(render(value, style));
        } else {
            println(render(value, style));
        }
        results += 1;
        last = value;
    }
}

if (opts.null_input or opts.slurp) {
    for (input in work) {
        process(input);
    }
} else {
    for (input in inputs(files)) {
        process(input);
    }
}

if (status == EXIT_OK and opts.exit_status) {
    if (results == 0) {
        status = EXIT_NO_OUTPUT;
    } else if (!truthy(last)) {
        status = EXIT_FALSE;
    }
}
exit(status);
