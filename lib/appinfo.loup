@mode(host.dual)

# Application identity and exit statuses for yq. Keep APP_NAME and
# APP_VERSION in step with `name` and `version` in package.lppkg.
#
# Runtime: host.dual, but only ever interpreted here: bin/yq.lpscr and
# lib/usage.loup import it under `loup run`, and the unit tests under
# Stage0's test runner. It holds only constants, so it stays compilable.

pub const APP_NAME: string = "yq";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Query YAML with jq filters; print JSON or YAML.";

# Exit statuses, as jq's.
pub const EXIT_OK: int = 0;
# -e: the last result was false or null.
pub const EXIT_FALSE: int = 1;
# A usage error, or an input that could not be read.
pub const EXIT_USAGE: int = 2;
# The filter does not parse.
pub const EXIT_COMPILE: int = 3;
# -e: there was no result.
pub const EXIT_NO_OUTPUT: int = 4;
# The filter failed on an input.
pub const EXIT_ERROR: int = 5;
