@mode(host.dual)

# The text yq prints for --help and --version.
#
# Runtime: host.dual, but only ever interpreted here: bin/yq.lpscr imports
# it under `loup run`, and tests/e2e.sh checks its output there. It uses
# nothing a native build lacks, so it stays compilable.

from .appinfo import (APP_NAME, APP_VERSION, APP_SUMMARY);

pub func usage(): string {
    let lines = [
        i"usage: {$ APP_NAME $} [OPTION]... FILTER [FILE]...",
        "",
        APP_SUMMARY,
        "FILTER is a jq filter; each YAML document of each FILE is one input",
        "(standard input when there is no FILE or FILE is -).",
        "",
        "  -y, --yaml-output       write the results as YAML",
        "  -r, --raw-output        write strings without quotes",
        "  -j, --join-output       like -r, and no newline after each result",
        "  -c, --compact-output    write each JSON result on one line",
        "      --indent N          indent JSON by N spaces (0 to 7, default 2)",
        "  -S, --sort-keys         sort the keys of every object",
        "  -s, --slurp             read all documents into one array",
        "  -n, --null-input        run the filter once, on null, reading nothing",
        "  -e, --exit-status       exit 1 if the last result is false or null,",
        "                          4 if there was none",
        "      --arg NAME VALUE    set $NAME to the string VALUE",
        "  -h, --help              display this help and exit",
        "  -V, --version           output version information and exit",
        "",
        "Filters: . .a .[0] .[1:3] .[] .. | , ( ) [ ] { } + - * / % == != < <= > >=",
        "and or // ? if-then-elif-else-end, EXPR as $x | ..., \"\\(interpolation)\",",
        "@json @text @csv @tsv @sh, and builtins such as length keys map select",
        "sort_by group_by unique min max add has to_entries with_entries range",
        "limit first last split join (README.md lists them all).",
        "",
        "Under `loup run`, long options go after `--`:",
        i"  loup run bin/{$ APP_NAME $}.lpscr -- --yaml-output '.items[]' app.yaml",
        "",
        "Exit status: 0 success, 1 last result false or null (-e), 2 usage error",
        "or unreadable input, 3 filter syntax error, 4 no result (-e), 5 error",
        "while running the filter.",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
