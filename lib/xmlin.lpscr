@mode(host.scripted)

# xq's XML reader: data.xml parses a document into elements, which become
# the values Python's xq gives (the mapping of its xmltodict library).
#
# Runtime: host.scripted. A module of the script bin/xq.lpscr, interpreted
# with it by `loup run`; the unit tests import it under Stage0's test runner
# (`loup-bootstrap test --no-parallel --file`). Only xq imports it: a
# program may load just one of data.xml, data.yaml and data.toml.
#
# Structure: XmlPreparer goes over the text once, character by character,
# and hands data.xml what it can read: CDATA sections become escaped text,
# character references (`&#233;`, `&#xE9;`) the characters they stand for,
# and the document type declaration is dropped. On the way it rejects what
# an XML parser rejects and data.xml lets through: an undefined entity, a
# stray `&`, text before the root element, a second root or text after it.
# data.xml's parse() then builds the tree, and element_value() turns each
# element into a value: null when it is empty, its text when it has
# nothing else, otherwise an object of its attributes (`@name`), its
# children by name (an array when a name repeats) and its text (`#text`).
# Both kinds of error are XmlParseErrors positioned in the prepared text,
# which keeps the original line of each of its lines, so a message names
# the line of the file.

from data.xml import (parse, Element, XmlParseError);
from .values import (InputError);
from .args import (Options);

# The five entities XML predefines; data.xml decodes these itself.
let PREDEFINED: set[string] = {"lt", "gt", "amp", "quot", "apos"};

func is_space(c: string): bool {
    return c == " " or c == "\t" or c == "\n";
}

# Whether `text`, between `&` and `;`, can be a reference: a name, or `#`
# and digits. Markup and whitespace cannot be part of one.
func reference_like(text: string): bool {
    if (text.len() == 0) {
        return false;
    }
    for (c in text) {
        if (is_space(c) or "&<>\"'".contains(c)) {
            return false;
        }
    }
    return true;
}

# The value of a character reference's digits (`233`, or `e9` after
# `&#x`), or -1 when they are not digits of that base. More than seven
# digits are too many for any character.
func reference_number(digits: string, base: int): int {
    if (digits.len() == 0 or digits.len() > 7) {
        return -1;
    }
    var value = 0;
    for (c in digits.toLowerCase()) {
        let d = "0123456789abcdef".index_of(c);
        if (d < 0 or d >= base) {
            return -1;
        }
        value = value * base + d;
    }
    return value;
}

# Whether XML allows character `code` in a document.
func allowed_character(code: int): bool {
    return code == 9 or code == 10 or code == 13 or (code >= 32 and code <= 55295)
        or (code >= 57344 and code <= 65533) or (code >= 65536 and code <= 1114111);
}

# One document on its way to data.xml: the prepared text as pieces (single
# characters, or entities that data.xml decodes), and for each prepared
# line the line of the original text it comes from.
pub class XmlPreparer {
    let chars: list[string];
    # The next character to read.
    var at: int = 0;
    # The original line of that character.
    var line: int = 1;
    # Characters in `pieces`: data.xml's error positions count them.
    var length: int = 0;
    # Elements open, and whether the root element has ended.
    var depth: int = 0;
    var root_done: bool = false;
    # A document type declaration may declare entities, which are then
    # dropped where they are used rather than refused.
    var has_doctype: bool = false;
    pub var pieces: list[string] = [];
    pub var origin: list[int] = [1];

    new(text: string) {
        let unix = text.replace("\r\n", "\n").replace("\r", "\n");
        this.chars = [c for c in unix];
    }

    func peek(k: int): string {
        let j = this.at + k;
        return if (j < this.chars.len()) { this.chars[j] } else { "" };
    }

    func looking_at(text: string): bool {
        var k = 0;
        for (c in text) {
            if (this.peek(k) != c) {
                return false;
            }
            k += 1;
        }
        return true;
    }

    # Text of the prepared document. A line break it adds (from `&#10;`)
    # stays on the current original line.
    modifier func emit(text: string): void {
        this.pieces.push(text);
        this.length += text.len();
        if (text == "\n") {
            this.origin.push(this.line);
        }
    }

    # The next character, passed on as it is.
    modifier func copy(): void {
        let c = this.chars[this.at];
        this.at += 1;
        if (c == "\n") {
            this.line += 1;
        }
        this.emit(c);
    }

    # Copies up to and including `end` (or to the end of the text, where
    # data.xml reports what is unterminated).
    modifier func copy_through(end: string): void {
        while (this.at < this.chars.len() and !this.looking_at(end)) {
            this.copy();
        }
        for (c in end) {
            if (this.at < this.chars.len()) {
                this.copy();
            }
        }
    }

    pub modifier func run(): void {
        # A byte order mark is not part of the document.
        if (this.peek(0) == "\u{FEFF}") {
            this.at += 1;
        }
        while (this.at < this.chars.len()) {
            let c = this.chars[this.at];
            if (c == "<") {
                this.markup();
            } else if (this.depth > 0) {
                if (c == "&") {
                    this.reference(false);
                } else {
                    this.copy();
                }
            } else if (is_space(c)) {
                this.copy();
            } else if (this.root_done) {
                throw XmlParseError("junk after document element", this.length);
            } else {
                throw XmlParseError("syntax error", this.length);
            }
        }
    }

    # Something that starts with `<`.
    modifier func markup(): void {
        if (this.looking_at("<!--")) {
            this.copy_through("-->");
        } else if (this.looking_at("<![CDATA[")) {
            this.cdata();
        } else if (this.looking_at("<!")) {
            this.declaration();
        } else if (this.looking_at("<?")) {
            this.copy_through("?>");
        } else if (this.looking_at("</")) {
            this.copy_through(">");
            this.depth -= 1;
            if (this.depth == 0) {
                this.root_done = true;
            }
        } else if (this.root_done) {
            throw XmlParseError("junk after document element", this.length);
        } else {
            this.start_tag();
        }
    }

    # `<![CDATA[...]]>`: its text, escaped so that data.xml reads it as
    # text.
    modifier func cdata(): void {
        let start = this.length;
        this.at += 9;
        while (!this.looking_at("]]>")) {
            if (this.at >= this.chars.len()) {
                throw XmlParseError("unclosed CDATA section", start);
            }
            let c = this.chars[this.at];
            if (c == "<") {
                this.at += 1;
                this.emit("&lt;");
            } else if (c == "&") {
                this.at += 1;
                this.emit("&amp;");
            } else if (c == ">") {
                this.at += 1;
                this.emit("&gt;");
            } else {
                this.copy();
            }
        }
        this.at += 3;
    }

    # `<!DOCTYPE ...>`, with its internal subset in brackets: dropped, but
    # its line breaks are kept so that the lines after it keep their
    # numbers.
    modifier func declaration(): void {
        let start = this.length;
        this.has_doctype = true;
        var bracket = false;
        var quote = "";
        while (true) {
            if (this.at >= this.chars.len()) {
                throw XmlParseError("unterminated declaration", start);
            }
            let c = this.chars[this.at];
            this.at += 1;
            if (c == "\n") {
                this.line += 1;
                this.emit("\n");
            } else if (quote != "") {
                if (c == quote) {
                    quote = "";
                }
            } else if (c == "\"" or c == "'") {
                quote = c;
            } else if (c == "[") {
                bracket = true;
            } else if (c == "]") {
                bracket = false;
            } else if (c == ">" and !bracket) {
                break;
            }
        }
    }

    # A start tag, through its `>`, with the references in its attribute
    # values resolved. `/>` closes the element at once.
    modifier func start_tag(): void {
        var quote = "";
        var last = "";
        while (this.at < this.chars.len()) {
            let c = this.chars[this.at];
            if (quote != "") {
                if (c == quote) {
                    quote = "";
                } else if (c == "&") {
                    this.reference(true);
                    continue;
                } else if (c == "<") {
                    throw XmlParseError("not well-formed (invalid token)", this.length);
                }
            } else if (c == "\"" or c == "'") {
                quote = c;
            } else if (c == ">") {
                this.copy();
                if (last != "/") {
                    this.depth += 1;
                } else if (this.depth == 0) {
                    this.root_done = true;
                }
                return;
            }
            if (!is_space(c)) {
                last = c;
            }
            this.copy();
        }
    }

    # A reference: `&#N;` or `&#xH;` becomes its character (an entity when
    # the character is markup), a predefined entity passes through, and
    # anything else is an error, or dropped when a document type
    # declaration may have declared it.
    modifier func reference(in_value: bool): void {
        let start = this.length;
        var name = "";
        var k = 1;
        while (k <= 32 and this.peek(k) != ";" and this.peek(k) != "") {
            name += this.peek(k);
            k += 1;
        }
        if (this.peek(k) != ";" or !reference_like(name)) {
            throw XmlParseError("not well-formed (invalid token)", start);
        }
        this.at += k + 1;
        if (PREDEFINED.contains(name)) {
            this.emit("&" + name + ";");
            return;
        }
        if (!name.startsWith("#")) {
            if (!this.has_doctype) {
                throw XmlParseError("undefined entity &" + name + ";", start);
            }
            return;
        }
        let hex = name.startsWith("#x");
        let code = if (hex) { reference_number(name.slice(2), 16) } else { reference_number(name.slice(1), 10) };
        if (code < 0) {
            throw XmlParseError("not well-formed (invalid token)", start);
        }
        if (!allowed_character(code)) {
            throw XmlParseError("reference to invalid character number", start);
        }
        let text = match code {
            60 => "&lt;",
            62 => "&gt;",
            38 => "&amp;",
            34 => "&quot;",
            39 => "&apos;",
            _ => str(char.of(code)),
        };
        this.emit(text);
    }

    # The original line of position `position` of the prepared text.
    pub func line_at(position: int): int {
        var seen = 0;
        var k = 0;
        for (piece in this.pieces) {
            if (seen >= position) {
                break;
            }
            if (piece == "\n") {
                k += 1;
            }
            seen += piece.len();
        }
        return this.origin[k];
    }

    pub func text(): string {
        return this.pieces.join("");
    }
}

# Adds `value` under `key`, as an array when the key is forced to be one
# (--xml-force-list).
func put(edits out: dict[string, Any], key: string, values: list[Any], force: list[string]): void {
    if (values.len() == 1 and !force.contains(key)) {
        out[key] = values[0];
    } else {
        out[key] = values;
    }
}

# One element as xq shows it.
pub func element_value(el: Element, force: list[string]): Any {
    var out: dict[string, Any] = {};
    for (name in el.attributes.keys()) {
        out["@" + name] = el.attributes[name];
    }
    # The children by name, in the order the names first appear; every
    # element of a name goes under it, wherever it is.
    for (child in el.children) {
        if (child is Element) {
            let tag = (child as Element).tag;
            if (!out.containsKey(tag)) {
                var values: list[Any] = [];
                for (same in el.findAll(tag)) {
                    values.push(element_value(same, force));
                }
                put(edits: out, tag, values, force);
            }
        }
    }
    # The text of the element itself, between and around its children,
    # without the whitespace at its ends.
    let text = el.text().trim();
    if (out.len() == 0) {
        return if (text == "") { None } else { text };
    }
    if (text != "") {
        out["#text"] = text;
    }
    return out;
}

# A whole document: an object with the root element's name as its key.
pub func document_value(root: Element, force: list[string]): Any {
    var out: dict[string, Any] = {};
    let value: list[Any] = [element_value(root, force)];
    put(edits: out, root.tag, value, force);
    return out;
}

# data.xml's message without its `XML parse error at N: ` lead, which the
# report replaces with the file name and line.
func reason(e: XmlParseError): string {
    let at = e.message.index_of(": ");
    return if (at >= 0) { e.message.slice(at + 2) } else { e.message };
}

# xq's reader: an XML file is one input. A file that is not well-formed
# gives its InputError instead, whether the preparer or data.xml found the
# fault.
pub func read_xml(text: string, name: string, opts: Options): list[Any] {
    let prep = XmlPreparer(text);
    try {
        safe {
            prep.run();
        }
        return [document_value(parse(prep.text()), opts.force_list)];
    } catch (XmlParseError as e) {
        return [InputError(name + ":" + str(prep.line_at(e.position)) + ": " + reason(e))];
    }
}
