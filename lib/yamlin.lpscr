@mode(host.scripted)

# yq's YAML reader: data.yaml for the block structure, with the YAML that
# configuration files use and data.yaml does not read handled around it.
#
# Runtime: host.scripted. A module of the script bin/yq.lpscr, interpreted
# with it by `loup run`; the unit tests import it under Stage0's test runner
# (`loup-bootstrap test --no-parallel --file`).
#
# Structure: documents() splits a file at `---` lines. Preparer rewrites
# one document into the subset data.yaml reads: a sequence item that
# starts a mapping or a nested sequence (`- name: a`) moves its content to
# a line of its own two columns deeper, and what data.yaml cannot read at
# all (flow collections, block scalars, quoted keys and values, `#` inside
# a plain value) is read here and replaced by a placeholder word. After
# data.yaml's parse, normalize() rebuilds the value recursively, putting
# the cut-out values back; the rebuild also leaves plain values that
# system.json can write. read_values() ties it together as a generator,
# and read_yaml() is yq's reader for lib/command.lpscr.

from data.yaml import (parse, YamlParseError);
from .flow import (FlowError, parse_flow, scalar_value);
from .values import (InputError);
from .args import (Options);

# One document of a file: its lines and the line number of the first.
pub struct DocText {
    pub first: int;
    pub lines: list[string];
}

func leading_spaces(line: string): int {
    var n = 0;
    while (n < line.len() and line.slice(n, n + 1) == " ") {
        n += 1;
    }
    return n;
}

func is_content(line: string): bool {
    let text = line.trim();
    return text != "" and !text.startsWith("#");
}

func is_marker(line: string): bool {
    let text = line.trimEnd();
    return text == "---" or text.startsWith("--- ") or text == "...";
}

# The documents of a file, one at a time. Lines starting with `%` before a
# document are directives and are skipped; empty documents are skipped.
pub gen func documents(text: string): Iterable[DocText] {
    var current: list[string] = [];
    var first = 1;
    var number = 0;
    var has_content = false;
    for (var line in text.split("\n")) {
        number += 1;
        if (line.endsWith("\r")) {
            line = line.slice(0, line.len() - 1);
        }
        if (is_marker(line)) {
            if (has_content) {
                yield DocText(first = first, lines = current);
            }
            current = [];
            first = number + 1;
            has_content = false;
            continue;
        }
        if (!has_content and line.startsWith("%")) {
            line = "";
        }
        if (is_content(line)) {
            has_content = true;
        }
        current.push(line);
    }
    if (has_content) {
        yield DocText(first = first, lines = current);
    }
}

# The end of the quoted text that starts at `start` (just past the closing
# quote), or -1.
func quoted_end(text: string, start: int): int {
    let quote = text.slice(start, start + 1);
    var k = start + 1;
    while (k < text.len()) {
        let c = text.slice(k, k + 1);
        if (quote == "\"" and c == "\\") {
            k += 2;
            continue;
        }
        if (c == quote) {
            if (quote == "'" and text.slice(k + 1, k + 2) == "'") {
                k += 2;
                continue;
            }
            return k + 1;
        }
        k += 1;
    }
    return -1;
}

# The offset of the `:` that ends a mapping key in `text`, or -1 when the
# text is not a mapping entry.
pub func mapping_colon(text: string): int {
    var k = 0;
    let first = text.slice(0, 1);
    if (first == "[" or first == "{") {
        return -1;
    }
    if (first == "\"" or first == "'") {
        k = quoted_end(text, 0);
        if (k < 0) {
            return -1;
        }
        while (k < text.len() and text.slice(k, k + 1) == " ") {
            k += 1;
        }
    }
    while (k < text.len()) {
        let c = text.slice(k, k + 1);
        if (c == ":" and (k + 1 == text.len() or " \t".contains(text.slice(k + 1, k + 2)))) {
            return k;
        }
        if (c == "#" and k > 0 and text.slice(k - 1, k) == " ") {
            return -1;
        }
        k += 1;
    }
    return -1;
}

# `|`, `|-`, `|+`, `>`, `>-`, `>+`, optionally with an indentation digit
# and a comment: the style and chomping, or "" for anything else.
func block_header(value: string): string {
    var text = value;
    let hash = text.index_of(" #");
    if (hash >= 0) {
        text = text.slice(0, hash);
    }
    text = text.trim();
    if (text == "" or !"|>".contains(text.slice(0, 1))) {
        return "";
    }
    var header = text.slice(0, 1);
    for (c in text.slice(1)) {
        if (c == "-" or c == "+") {
            header = header + c;
        } else if (c < "1" or c > "9") {
            return "";
        }
    }
    return header;
}

# Brackets still open in `text`, outside quotes.
func open_brackets(text: string): int {
    var depth = 0;
    var k = 0;
    while (k < text.len()) {
        let c = text.slice(k, k + 1);
        if (c == "\"" or c == "'") {
            let end = quoted_end(text, k);
            if (end < 0) {
                return depth + 1;
            }
            k = end;
            continue;
        }
        if (c == "[" or c == "{") {
            depth += 1;
        } else if (c == "]" or c == "}") {
            depth -= 1;
        } else if (c == "#" and k > 0 and text.slice(k - 1, k) == " ") {
            return depth;
        }
        k += 1;
    }
    return depth;
}

# Folds the lines of a `>` block: lines join with spaces, and an empty line
# stands for a line break.
func fold(lines: list[string]): string {
    var out = "";
    var joinable = false;
    for (line in lines) {
        if (line == "") {
            out = out + "\n";
            joinable = false;
        } else {
            out = out + (if (joinable) { " " } else { "" }) + line;
            joinable = true;
        }
    }
    return out;
}

# YAML lets a sequence under a key start in the key's own column
# (`items:` then `- a`); data.yaml wants it deeper. Such sequences are
# moved two columns to the right, with everything inside them.
func indent_sequences(lines: list[string]): list[string] {
    var out: list[string] = [];
    for (line in lines) {
        out.push(line);
    }
    for (k in 0..out.len()) {
        let line = out[k];
        if (!is_content(line)) {
            continue;
        }
        # The key may follow sequence dashes: `- y:` has its key in column 2.
        var indent = leading_spaces(line);
        var body = line.slice(indent);
        while (body.startsWith("- ")) {
            let after = body.slice(1).trimStart();
            indent += body.len() - after.len();
            body = after;
        }
        let colon = mapping_colon(body);
        let rest = if (colon >= 0) { body.slice(colon + 1).trim() } else { "x" };
        if (rest != "" and !rest.startsWith("#")) {
            continue;
        }
        var j = k + 1;
        while (j < out.len() and !is_content(out[j])) {
            j += 1;
        }
        if (j == out.len() or leading_spaces(out[j]) != indent) {
            continue;
        }
        let first = out[j].trim();
        if (first != "-" and !first.startsWith("- ")) {
            continue;
        }
        while (j < out.len()) {
            let next = out[j];
            let spaces = leading_spaces(next);
            let item = spaces == indent and (next.trim() == "-" or next.trim().startsWith("- "));
            if (is_content(next) and spaces <= indent and !item) {
                break;
            }
            # Comment lines move too: inside a block scalar they are text.
            if (next.trim() != "") {
                out[j] = "  " + next;
            }
            j += 1;
        }
    }
    return out;
}

# One document rewritten for data.yaml: its lines, the original line
# number of each, and the values cut out under placeholder words.
pub class Preparer {
    var source: list[string];
    let first: int;
    let name: string;
    pub var lines: list[string] = [];
    pub var origin: list[int] = [];
    pub var cut: dict[string, Any] = {};

    new(doc: DocText, name: string) {
        this.source = doc.lines;
        this.first = doc.first;
        this.name = name;
    }

    # `FILE:LINE: message` for line k of the document.
    func located(k: int, message: string): string {
        return this.name + ":" + str(this.first + k) + ": " + message;
    }

    modifier func emit(indent: int, text: string, k: int): void {
        this.lines.push(" ".repeat(indent) + text);
        this.origin.push(this.first + k);
    }

    modifier func placeholder(value: Any): string {
        let word = "__yq_value_" + str(this.cut.len()) + "__";
        this.cut[word] = value;
        return word;
    }

    pub modifier func run(): void {
        this.source = indent_sequences(this.source);
        var k = 0;
        while (k < this.source.len()) {
            let line = this.source[k];
            if (!is_content(line)) {
                k += 1;
                continue;
            }
            let indent = leading_spaces(line);
            k = this.item(k, indent, line.slice(indent));
        }
    }

    # One entry starting at line k with its text at column `indent`;
    # returns the index of the next line to read.
    modifier func item(k: int, indent: int, body: string): int {
        if (body == "-" or body.startsWith("- ")) {
            let rest = body.slice(1).trimStart();
            let column = indent + body.len() - rest.len();
            if (rest == "" or rest.startsWith("#")) {
                this.emit(indent, "-", k);
                return k + 1;
            }
            if (rest == "-" or rest.startsWith("- ") or mapping_colon(rest) >= 0) {
                # `- name: a` is `-` and then `name: a` two columns deeper.
                this.emit(indent, "-", k);
                return this.item(k, column, rest);
            }
            return this.value(k, indent, "-", rest);
        }
        let colon = mapping_colon(body);
        if (colon < 0) {
            # A lone value: a document that is a single scalar.
            return this.value(k, indent, "", body);
        }
        var key = body.slice(0, colon).trim();
        if (key.startsWith("\"") or key.startsWith("'")) {
            key = this.placeholder(parse_flow(key));
        }
        return this.value(k, indent, key + ":", body.slice(colon + 1).trim());
    }

    # The lines after line k that continue a plain scalar: those indented
    # deeper than `indent`, with blank lines between them. Returns the
    # index after the last one (k + 1 when there are none).
    func plain_end(k: int, indent: int): int {
        var end = k + 1;
        var j = k + 1;
        while (j < this.source.len()) {
            let line = this.source[j];
            if (line.trim() == "") {
                j += 1;
                continue;
            }
            # A comment ends a plain scalar, wherever it is indented.
            if (leading_spaces(line) <= indent or line.trim().startsWith("#")) {
                break;
            }
            j += 1;
            end = j;
        }
        return end;
    }

    # A plain scalar written over several lines: its lines fold into one
    # string, as in a `>` block.
    modifier func multiline(k: int, indent: int, lead: string, text: string, end: int): int {
        var parts: list[string] = [];
        if (text != "") {
            parts.push(text);
        }
        for (j in (k + 1)..end) {
            parts.push(this.source[j].trim());
        }
        this.emit(indent, lead + this.placeholder(scalar_value(fold(parts))), k);
        return end;
    }

    # The value after `head` ("-", "key:" or nothing) on line k.
    modifier func value(k: int, indent: int, head: string, text: string): int {
        let lead = if (head == "") { "" } else { head + " " };
        if (text == "" or text.startsWith("#")) {
            # A plain scalar may start on the next line, deeper.
            let end = this.plain_end(k, indent);
            if (end > k + 1) {
                let next = this.source[k + 1].trim();
                let starts = next.slice(0, 1);
                if (next != "-" and !next.startsWith("- ") and mapping_colon(next) < 0 and !"[{\"'|>#".contains(starts)) {
                    return this.multiline(k, indent, lead, "", end);
                }
            }
            this.emit(indent, head, k);
            return k + 1;
        }
        let first = text.slice(0, 1);
        if (first == "[" or first == "{") {
            return this.flow(k, indent, lead, text);
        }
        let header = block_header(text);
        if (header != "") {
            return this.block(k, indent, lead, header);
        }
        if (first == "\"" or first == "'") {
            this.emit(indent, lead + this.placeholder(this.read_flow(k, text)), k);
            return k + 1;
        }
        let end = this.plain_end(k, indent);
        if (end > k + 1) {
            return this.multiline(k, indent, lead, text, end);
        }
        # A plain value: YAML starts a comment only at ` #`, data.yaml at
        # any `#`, so a value with a `#` in it is typed here; so is a number
        # too long for data.yaml's 64-bit integers.
        if (text.contains("#") or head == "" or text.len() > 18) {
            var plain = text;
            let hash = plain.index_of(" #");
            if (hash >= 0) {
                plain = plain.slice(0, hash);
            }
            this.emit(indent, lead + this.placeholder(scalar_value(plain)), k);
            return k + 1;
        }
        this.emit(indent, lead + text, k);
        return k + 1;
    }

    func read_flow(k: int, text: string): Any {
        try {
            return parse_flow(text);
        } catch (FlowError as e) {
            throw InputError(this.located(k, e.message));
        }
    }

    # A flow collection, continued on the following lines until its
    # brackets close.
    modifier func flow(k: int, indent: int, lead: string, text: string): int {
        var whole = text;
        var next = k + 1;
        while (open_brackets(whole) > 0 and next < this.source.len()) {
            whole = whole + " " + this.source[next].trim();
            next += 1;
        }
        if (open_brackets(whole) > 0) {
            throw InputError(this.located(k, "unterminated flow collection"));
        }
        this.emit(indent, lead + this.placeholder(this.read_flow(k, whole)), k);
        return next;
    }

    # A literal (`|`) or folded (`>`) block scalar: the following lines
    # indented deeper than its key, with chomping: clip keeps one final
    # line break, `-` none, `+` all.
    modifier func block(k: int, indent: int, lead: string, header: string): int {
        var body: list[string] = [];
        var depth = -1;
        var next = k + 1;
        while (next < this.source.len()) {
            let line = this.source[next];
            if (line.trim() == "") {
                body.push("");
                next += 1;
                continue;
            }
            let spaces = leading_spaces(line);
            if (spaces <= indent or (depth >= 0 and spaces < depth)) {
                break;
            }
            if (depth < 0) {
                depth = spaces;
            }
            body.push(line.slice(depth));
            next += 1;
        }
        var trailing = 0;
        while (body.len() > 0 and body[-1] == "") {
            body.pop();
            trailing += 1;
        }
        var text = if (header.startsWith(">")) { fold(body) } else { body.join("\n") };
        if (body.len() > 0) {
            if (header.endsWith("+")) {
                text = text + "\n".repeat(trailing + 1);
            } else if (!header.endsWith("-")) {
                text = text + "\n";
            }
        }
        this.emit(indent, lead + this.placeholder(text), k);
        return next;
    }
}

# The value data.yaml read, rebuilt: placeholders replaced by the values
# they stand for, keys included.
pub func normalize(v: Any, cut: dict[string, Any]): Any {
    if (v == None) {
        return None;
    }
    match v {
        string(text) => {
            match cut.get(text) {
                Some(original) => {
                    return original;
                },
                None => {
                    return text;
                },
            }
        },
        int(n) => {
            return n;
        },
        float(f) => {
            return f;
        },
        bool(b) => {
            return b;
        },
        _ => {},
    }
    match v as? list[Any] {
        Some(items) => {
            var out: list[Any] = [];
            for (item in items) {
                out.push(normalize(item, cut));
            }
            return out;
        },
        None => {},
    }
    let members = v as dict[string, Any];
    var out: dict[string, Any] = {};
    for (key in members.keys()) {
        let name = match cut.get(key) {
            Some(original) => str(original),
            None => key,
        };
        out[name] = normalize(members[key], cut);
    }
    return out;
}

# Every document of a YAML file, as values, in order. A document that
# cannot be read comes out as its InputError (a value, not thrown): the
# self-hosted `loup run` runs a generator to its end before the loop over
# it starts, so a throw here would also lose the documents before it.
pub gen func read_values(text: string, name: string): Iterable[Any] {
    for (doc in documents(text)) {
        let prep = Preparer(doc, name);
        var unreadable: InputError? = None;
        try {
            safe {
                prep.run();
            }
        } catch (InputError as e) {
            unreadable = Some(e);
        }
        if (unreadable.is_some()) {
            yield unreadable!;
        } else if (prep.lines.len() == 1 and !prep.lines[0].startsWith("-") and mapping_colon(prep.lines[0].trim()) < 0) {
            # One value and no structure: data.yaml reads only mappings
            # and sequences.
            yield normalize(prep.lines[0].trim(), prep.cut);
        } else {
            var raw: Any = None;
            var problem = "";
            try {
                raw = parse(prep.lines.join("\n"));
            } catch (YamlParseError as e) {
                let at = e.message.index_of("): ");
                let message = if (at >= 0) { e.message.slice(at + 3) } else { e.message };
                let line = if (e.line >= 1 and e.line <= prep.origin.len()) { prep.origin[e.line - 1] } else { doc.first };
                problem = name + ":" + str(line) + ": " + message;
            }
            if (problem != "") {
                yield InputError(problem);
            } else {
                yield normalize(raw, prep.cut);
            }
        }
    }
}

# yq's reader: the documents of one file, as lib/command.lpscr takes them
# from each program's reader (the options matter only to xq).
pub func read_yaml(text: string, name: string, opts: Options): list[Any] {
    var values: list[Any] = [];
    for (value in read_values(text, name)) {
        values.push(value);
    }
    return values;
}
